:root {
  --bg: #f5efe8;
  --bg-strong: #efe6d9;
  --card: rgba(255, 255, 255, 0.7);
  --card-strong: #fffdf9;
  --navy: #182b49;
  --navy-2: #243d5c;
  --gold: #b38a5d;
  --gold-soft: #e9d5b0;
  --text: #1d2b3d;
  --muted: #6a6d72;
  --line: rgba(24, 43, 73, 0.12);
  --shadow: 0 22px 50px rgba(22, 31, 44, 0.12);
  --shadow-soft: 0 14px 30px rgba(22, 31, 44, 0.08);
  --serif: "Playfair Display", Georgia, serif;
  --sans: "DM Sans", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  font-family: var(--sans);
  background:
    radial-gradient(circle at top left, rgba(179, 138, 93, 0.15), transparent 30%),
    linear-gradient(180deg, #f9f5f0 0%, var(--bg) 100%);
  color: var(--text);
  line-height: 1.7;
  overflow-x: hidden;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

p {
  margin: 0 0 14px;
}

h1, h2, h3 {
  margin-top: 0;
  line-height: 1.15;
}

h1, h2 {
  font-family: var(--serif);
}

h3 {
  font-size: 1.1rem;
}

::selection {
  background: var(--navy);
  color: white;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  padding: 20px 7%;
  background: rgba(245, 239, 232, 0.72);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(24, 43, 73, 0.08);
}

.brand {
  font-family: var(--serif);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.08em;
}

.brand span {
  color: var(--gold);
}

.main-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.main-nav a {
  position: relative;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(29, 43, 61, 0.9);
  transition: color 0.25s ease;
}

.main-nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 100%;
  height: 2px;
  background: var(--gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s ease;
}

.main-nav a:hover::after,
.main-nav a:focus-visible::after {
  transform: scaleX(1);
}

.main-nav a:hover {
  color: var(--gold);
}

.section {
  width: min(1180px, calc(100% - 60px));
  margin: 0 auto;
  padding: 90px 0;
}

.hero {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  min-height: 640px;
  gap: 3rem;
  padding-top: 70px;
}

.eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 1.2rem;
}

.hero h1 {
  font-size: clamp(4rem, 7vw, 7rem);
  letter-spacing: -0.06em;
  margin-bottom: 0.5rem;
}

.hero h1 span {
  color: var(--gold);
}

.hero h2 {
  font-family: var(--sans);
  font-weight: 500;
  font-size: clamp(1.7rem, 2.5vw, 2.7rem);
  margin-bottom: 1rem;
}

.hero-copy p {
  max-width: 640px;
  font-size: 1.08rem;
  color: rgba(29, 43, 61, 0.8);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin: 2rem 0 2.3rem;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.95rem 1.6rem;
  border-radius: 999px;
  font-size: 0.83rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
}

.button:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 26px rgba(24, 43, 73, 0.12);
}

.button-primary {
  background: linear-gradient(135deg, var(--navy), var(--navy-2));
  color: white;
}

.button-secondary {
  background: rgba(255,255,255,0.5);
  border: 1px solid rgba(24, 43, 73, 0.12);
  color: var(--navy);
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 1rem;
  max-width: 720px;
}

.hero-meta div {
  padding: 1rem 0.8rem;
  border-top: 1px solid var(--line);
}

.hero-meta strong {
  display: block;
  font-size: 1.5rem;
  color: var(--navy);
  margin-bottom: 0.25rem;
}

.hero-meta span {
  font-size: 0.8rem;
  color: var(--muted);
}

.hero-visual {
  position: relative;
  min-height: 540px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.glass-card {
  width: min(100%, 380px);
  padding: 1.1rem 1.1rem 1.4rem;
  background: rgba(255, 255, 255, 0.45);
  border: 1px solid rgba(255,255,255,0.7);
  border-radius: 28px;
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
  z-index: 2;
}

.badge {
  display: inline-block;
  padding: 0.4rem 0.7rem;
  background: rgba(179, 138, 93, 0.14);
  border: 1px solid rgba(179, 138, 93, 0.22);
  border-radius: 999px;
  color: var(--navy);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.profile-ring {
  width: 180px;
  height: 180px;
  margin: 1.2rem auto 1.1rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background:
    radial-gradient(circle at center, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.2) 45%, transparent 46%),
    linear-gradient(135deg, rgba(179,138,93,0.25), rgba(24,43,73,0.18));
  border: 1px solid rgba(24,43,73,0.1);
  box-shadow: inset 0 0 0 18px rgba(255,255,255,0.45);
}

.initials {
  font-family: var(--serif);
  font-size: 4rem;
  font-weight: 700;
  letter-spacing: -0.08em;
  color: var(--navy);
}

.glass-card ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0.7rem;
}

.glass-card li {
  position: relative;
  padding-left: 1.3rem;
  color: rgba(29, 43, 61, 0.8);
  font-size: 0.96rem;
}

.glass-card li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.56rem;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold), #d7b587);
}

.floating-panel {
  position: absolute;
  padding: 0.9rem 1rem;
  border-radius: 18px;
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(24, 43, 73, 0.08);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(8px);
  animation: float 5s ease-in-out infinite;
}

.floating-panel span {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.2rem;
}

.floating-panel strong {
  font-size: 1rem;
  color: var(--navy);
}

.panel-1 {
  top: 90px;
  right: 30px;
}

.panel-2 {
  bottom: 80px;
  left: 18px;
  animation-delay: 1.5s;
}

.section-heading {
  margin-bottom: 2.2rem;
}

.section-heading h2 {
  font-size: clamp(2.1rem, 3.7vw, 3.2rem);
  margin: 0;
}

.about-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 1.6rem;
}

.content-card {
  background: rgba(255,255,255,0.48);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 2rem 1.5rem;
  box-shadow: var(--shadow-soft);
}

.content-card h3 {
  font-family: var(--serif);
  font-size: 2rem;
  margin-bottom: 0.7rem;
}

.content-card p {
  color: rgba(29,43,61,0.8);
  font-size: 1rem;
}

.content-card.highlight {
  background: linear-gradient(135deg, rgba(179,138,93,0.12), rgba(255,255,255,0.7));
  border-color: rgba(179,138,93,0.14);
}

.mini-label {
  display: inline-block;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--muted);
  margin-bottom: 0.7rem;
}

.timeline {
  position: relative;
  display: grid;
  gap: 1.8rem;
  padding-left: 1rem;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 13px;
  top: 18px;
  bottom: 18px;
  width: 2px;
  background: linear-gradient(180deg, rgba(179,138,93,0.6), rgba(24,43,73,0.14));
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 26px 1fr;
  align-items: start;
  gap: 1.2rem;
}

.timeline-dot {
  width: 26px;
  height: 26px;
  background: linear-gradient(135deg, var(--gold), #d8b98c);
  border: 4px solid rgba(255,255,255,0.8);
  border-radius: 50%;
  box-shadow: 0 0 0 4px rgba(179,138,93,0.12);
  position: relative;
  z-index: 1;
}

.timeline-content {
  background: rgba(255,255,255,0.5);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 1.5rem 1.5rem 1.2rem;
  box-shadow: var(--shadow-soft);
}

.tag-row {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 0.75rem;
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.timeline-content h3 {
  font-family: var(--serif);
  font-size: 2rem;
  margin-bottom: 0.7rem;
}

.timeline-content p,
.timeline-content li {
  color: rgba(29,43,61,0.8);
  font-size: 0.98rem;
}

.timeline-content ul {
  margin: 0.9rem 0 0;
  padding-left: 1.2rem;
  display: grid;
  gap: 0.4rem;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 1.5rem;
}

.project-card {
  background: rgba(255,255,255,0.5);
  border: 1px solid var(--line);
  border-radius: 22px;
  min-height: 230px;
  padding: 1.3rem;
  box-shadow: var(--shadow-soft);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}

.project-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 18px 34px rgba(24,43,73,0.1);
  border-color: rgba(179,138,93,0.2);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.7rem;
  margin-bottom: 1rem;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.38rem 0.7rem;
  border-radius: 999px;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: rgba(179,138,93,0.12);
  color: var(--navy);
  font-weight: 700;
}

.chip.dark {
  background: rgba(24,43,73,0.08);
}

.project-card h3 {
  font-family: var(--serif);
  font-size: 1.7rem;
  margin-bottom: 0.8rem;
}

.project-card p {
  color: rgba(29,43,61,0.8);
}

.edu-stack {
  display: grid;
  gap: 1rem;
}

.edu-item {
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 1.2rem;
  padding: 1.35rem 1.4rem;
  background: rgba(255,255,255,0.5);
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: var(--shadow-soft);
}

.year {
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding-top: 0.25rem;
}

.edu-item h3 {
  font-family: var(--serif);
  font-size: 1.8rem;
  margin-bottom: 0.35rem;
}

.edu-item p {
  margin: 0;
  color: rgba(29,43,61,0.8);
}

.achievement-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  flex-wrap: wrap;
  margin-top: 1.5rem;
  padding: 0.8rem 1rem;
  background: linear-gradient(135deg, rgba(179,138,93,0.15), rgba(255,255,255,0.75));
  border: 1px solid rgba(179,138,93,0.2);
  border-radius: 999px;
  color: var(--navy);
}

.achievement-pill span,
.achievement-pill em {
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--muted);
}

.achievement-pill strong {
  font-size: 1.1rem;
}

.cta-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.5rem;
  padding: 2rem 2rem;
  background: linear-gradient(135deg, var(--navy), var(--navy-2));
  border-radius: 26px;
  color: white;
  box-shadow: var(--shadow);
}

.cta-box h2 {
  margin: 0 0 0.6rem;
  font-size: clamp(2.1rem, 4vw, 3.2rem);
}

.cta-box p {
  color: rgba(255,255,255,0.8);
  max-width: 600px;
  margin: 0;
}

.contact-links {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  align-items: flex-start;
}

.contact-links a {
  font-weight: 600;
  color: white;
  border-bottom: 1px solid rgba(233, 213, 176, 0.6);
  padding-bottom: 0.3rem;
  transition: color 0.25s ease, transform 0.25s ease;
}

.contact-links a:hover {
  color: var(--gold-soft);
  transform: translateY(-1px);
}

.resume-section {
  padding: 90px 0 100px;
}

.resume-inner {
  width: min(1180px, calc(100% - 60px));
  margin: 0 auto;
}

.resume-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.2rem;
}

.resume-header h2 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.resume-paper {
  background: rgba(255,255,255,0.85);
  border: 1px solid rgba(24,43,73,0.08);
  border-radius: 24px;
  box-shadow: var(--shadow-soft);
  padding: 2.5rem 2.3rem;
}

.resume-top {
  padding-bottom: 1rem;
  border-bottom: 2px solid rgba(24,43,73,0.8);
}

.resume-top h1 {
  font-size: clamp(2.3rem, 4vw, 3rem);
  margin-bottom: 0.35rem;
  letter-spacing: -0.05em;
}

.resume-top > p {
  margin-bottom: 0.7rem;
  font-weight: 700;
  color: var(--navy);
}

.resume-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.78rem;
  color: var(--muted);
}

.resume-block {
  padding: 1rem 0;
  border-bottom: 1px solid rgba(24,43,73,0.08);
}

.resume-block:last-child {
  border-bottom: none;
}

.resume-block h2 {
  font-family: var(--sans);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--navy);
  margin-bottom: 0.7rem;
}

.resume-block h3 {
  font-size: 0.95rem;
  margin-bottom: 0.2rem;
}

.resume-block p {
  color: rgba(29,43,61,0.8);
  margin-bottom: 0.5rem;
}

.site-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1.4rem 7% 2.2rem;
  color: var(--muted);
  background: rgba(255,255,255,0.15);
  border-top: 1px solid rgba(24,43,73,0.08);
}

.site-footer p {
  margin: 0;
  font-size: 0.8rem;
}

.site-footer a:last-child {
  font-size: 0.8rem;
  font-weight: 600;
}

.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-12px); }
}

@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
    padding-top: 40px;
  }

  .hero-visual {
    min-height: 420px;
  }

  .about-grid,
  .project-grid {
    grid-template-columns: 1fr;
  }

  .cta-box {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 700px) {
  .site-header {
    flex-direction: column;
    align-items: flex-start;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .main-nav {
    gap: 0.9rem 1.2rem;
  }

  .section,
  .resume-inner {
    width: min(100% - 34px, 1180px);
  }

  .hero-meta {
    grid-template-columns: 1fr;
  }

  .timeline-item {
    grid-template-columns: 20px 1fr;
  }

  .edu-item {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 3.5rem;
  }

  .resume-header,
  .site-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .resume-paper {
    padding: 1.5rem 1.1rem;
  }

  .floating-panel {
    display: none;
  }
}
